# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/matchathon
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/matchathon
MONGO_URI=mongodb://127.0.0.1:27017/matchathon

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Optional
PORT=5001
# Comma-separated list of frontend origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:3000
